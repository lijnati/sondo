# Copy to .env.local. Every variable is optional for the Phase 1 shell: the app runs
# with none set. Values are validated server-side by lib/env/schema.ts and never sent
# to the browser.

# Qloo hackathon key — valid ONLY against https://hackathon.api.qloo.com.
# Required from Phase 1b (Qloo data layer) and by `pnpm spike`.
QLOO_API_KEY=

# Optional. Defaults to the hackathon host; any other value is rejected.
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Phase 2 (agent): Vercel AI Gateway key for the LLM calls.
# AI_GATEWAY_API_KEY=

# Phase 1b/3: Neon Postgres (runs, private Qloo cache). postgres:// or postgresql://
# DATABASE_URL=
