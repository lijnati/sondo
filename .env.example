# Copy to .env.local. The app shell runs with none of these set. Values are validated
# server-side by lib/env/schema.ts and never sent to the browser or logged.

# Qloo hackathon key — valid ONLY against https://hackathon.api.qloo.com.
# Required by `pnpm probe`, `pnpm explore`, `pnpm agent` and `pnpm spike`.
QLOO_API_KEY=

# Optional. Defaults to the hackathon host; any other value is rejected.
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Vercel AI Gateway key (Vercel dashboard → AI Gateway → API Keys). Required for
# `pnpm agent` (without --no-model) and `pnpm model:smoke`, even for $0 models.
# Recommended: set a spending budget (e.g. $5) on the key itself — Sondo's cost
# limit below is an app-side ESTIMATE, not a billing cap.
AI_GATEWAY_API_KEY=

# Agent model ("provider/model" on the AI Gateway). Default: nvidia/nemotron-3.5-lightning-free ($0).
# e.g. openai/gpt-5-mini ($0.25 / $2 per million input/output tokens).
# SONDO_MODEL=

# Per-run estimated cost limit in USD (default 0.15).
# SONDO_RUN_COST_LIMIT_USD=

# Prices for models missing from the built-in table (USD per million tokens).
# SONDO_MODEL_INPUT_USD_PER_MTOK=
# SONDO_MODEL_OUTPUT_USD_PER_MTOK=

# Phase 3: Neon Postgres (runs, private Qloo cache). Not used yet.
# DATABASE_URL=
